# Local test captures and generated diagnostics
fitsocial_app/current_emulator_*.png
fitsocial_app/*_dump.xml
fitsocial_app/*_check.xml
fitsocial_app/manual_*.xml
fitsocial_app/android_build_log.txt
fitsocial_app/flutter_run_*.txt
fitsocial_app/flutter_run_*.log
fitsocial_app/flutter_run_*.err.log
fitsocial_app/window_dump.xml

# Flutter/IDE generated files covered here for the root repository too
fitsocial_app/.dart_tool/
fitsocial_app/.idea/
fitsocial_app/build/
fitsocial_app/android/build/
fitsocial_app/*.iml

# Android Studio writes a project at the repository root as well as inside
# fitsocial_app/ — workspace.xml in particular churns on every IDE action.
/.idea/
/*.iml

# Kotlin build-tool scratch dir, created next to the Gradle project.
fitsocial_app/android/.kotlin/

# Shareable build output from tool/package_apk.ps1 — a ~70 MB APK and a ~50 MB
# R8 mapping file per build. Attach these to a release, never to a commit.
fitsocial_app/dist/

# Written analysis/report documents kept alongside the checkout. Binary Office
# files can't be diffed or merged, so they bloat history to no benefit.
/*.docx

# Service-account keys. These grant full admin access to the Firebase project —
# every user record, every document — and committing one cannot be undone by
# deleting it later: the key stays in history and must be revoked instead.
# Firebase downloads them as <project>-firebase-adminsdk-<hash>.json.
*-firebase-adminsdk-*.json
*serviceAccount*.json
*service-account*.json
application_default_credentials.json

# Local editor/agent workspace settings. Per-machine tool configuration that
# carries no project meaning and differs for every collaborator.
.claude/
