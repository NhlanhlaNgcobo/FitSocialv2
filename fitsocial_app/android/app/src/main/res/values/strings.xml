<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown in Settings > Notification access, next to the toggle the user
         has to switch on. It is the only place this name appears, so it says
         what the access is actually used for rather than repeating the app
         name back at them. -->
    <string name="media_session_listener_label">FitSocial music controls</string>

    <!-- The channel every social push lands on.

         The id is named in AndroidManifest.xml and the channel is created in
         MainActivity.kt; the two must agree. If they disagree, FCM falls back to
         a channel of its own making called "Miscellaneous", and that is the name
         the user finds in Android notification settings when they go looking for
         a way to quieten this app.

         The id is never shown to anyone. The name and description are. -->
    <string name="fcm_channel_social_id" translatable="false">fitsocial_social</string>
    <string name="fcm_channel_social_name">Social</string>
    <string name="fcm_channel_social_description">Follows, reactions, comments, mentions and challenge updates</string>

    <!-- Panic alerts from safety contacts. Its own channel so that quietening
         Social never silences an emergency. The id is named by
         functions/safety.js on every panic push and created in MainActivity.kt. -->
    <string name="fcm_channel_panic_id" translatable="false">panic_alerts</string>
    <string name="fcm_channel_panic_name">Safety alerts</string>
    <string name="fcm_channel_panic_description">Panic alerts from people who chose you as a safety contact</string>
</resources>
