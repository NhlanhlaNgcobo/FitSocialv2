<?xml version="1.0" encoding="utf-8"?>
<!--
    The FitSocial F as a status-bar icon.

    Same five traced paths as drawable/splash_mark.xml, on a 24dp canvas and
    flattened to solid white. The flattening is not a style choice: Android
    masks a status-bar icon by its alpha channel and tints the result itself, so
    the gradients and the 0.78 fillAlpha the splash mark carries would be
    discarded on the way through — and the fillAlpha would come back as a
    washed-out silhouette rather than a softer one.

    Without this drawable, FCM falls back to the launcher icon, which the system
    renders as a featureless grey square.

    The transform fits the traced 825x608 mark into 24x24 leaving roughly 4dp of
    vertical breathing room: scale 0.02662 (= 16 / 601), then translated so the
    artwork sits centred. If splash_mark.xml is regenerated by
    tool/gen_splash_mark.py with different paths, these have to be retraced too.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">

    <group
        android:translateX="1.02"
        android:translateY="3.92"
        android:scaleX="0.02662"
        android:scaleY="0.02662">

        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M182,452L380,452L382,454L335,567L321,586L306,597L293,602L279,604L107,604L104,602L105,595L151,483L161,464L170,456Z" />
        <path
