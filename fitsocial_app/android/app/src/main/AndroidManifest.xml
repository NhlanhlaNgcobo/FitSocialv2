<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Location: precise GPS for run tracking -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <!-- Background location: keeps GPS alive when screen turns off during a run (Android 10+) -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>
    <!-- Foreground service: required to run location tracking in a foreground service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <!-- Foreground service location type: required on Android 14+ (API 34) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <!-- Wake lock: the live-run foreground service holds a partial wake lock so
         GPS fixes keep arriving once per second with the screen off, instead of
         being buffered and delivered in a burst when the phone next wakes. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- Notifications: Android 13+ needs this to display the ongoing "run in
         progress" notification. Tracking still works if it is refused — only
         the lock-screen readout is lost. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Activity recognition: needed to use the hardware step counter sensor (Android 10+) -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION"/>
    <!-- Body sensors: heart-rate via device/wearable sensors -->
    <uses-permission android:name="android.permission.BODY_SENSORS"/>
    <!-- Media read access: the system photo picker itself needs no
         permission, but some OEM galleries and Android <= 12 devices
         require these to resolve the picked image URI. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <!-- Video: Pulse clips are picked from the gallery the same way. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <!-- Saving the run card to the gallery. From API 29 a MediaStore insert
         needs no permission at all; 26-28 wrote to the public folder. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28"/>
    <!-- Bluetooth LE: scan/connect to heart-rate monitors and smartwatches -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <!-- Legacy Bluetooth permissions for Android 11 and below -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30"/>
    <!-- Health Connect: read fitness/health data synced from phone + smartwatches -->
    <uses-permission android:name="android.permission.health.READ_STEPS"/>
    <uses-permission android:name="android.permission.health.READ_HEART_RATE"/>
    <uses-permission android:name="android.permission.health.READ_SLEEP"/>
    <uses-permission android:name="android.permission.health.READ_DISTANCE"/>
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED"/>
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED"/>
    <uses-permission android:name="android.permission.health.READ_EXERCISE"/>
    <application
        android:label="FitSocial"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />
        <!-- How a push notification looks before the app has had a chance to
             say anything about it.

             FCM draws the tray entry itself while the app is backgrounded or
             killed, using these three defaults. Without the icon it falls back
             to the launcher icon, which the system renders as a grey square;
             without the channel id it invents one called "Miscellaneous", which
             is then the name the user finds in Android notification settings.

             The channel named here is created in MainActivity.kt. Declaring a
             channel that does not exist is not an error and not visible - the
             notification simply lands on the fallback - so the two have to be
             changed together. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/fcm_channel_social_id" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_fitsocial" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Hands the launch URL to the Flutter engine, which passes it to
                 GoRouter as the initial route. Without this the intent filters
                 below still open the app, but always on the feed. -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Shared post/profile links.
                 https://fitsocialv2.web.app/post/{id} — an App Link, so a
                 phone with FitSocial installed opens it here instead of in a
                 browser. autoVerify makes Android check
                 /.well-known/assetlinks.json on that host at install time; it
                 must list this package and the SHA-256 fingerprint of the
                 signing key, or the link keeps opening the web page (which
                 still works — see hosting/open.html). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <!-- Scoped to the two path prefixes that name shareable
                     content, and NOT left as a bare host. A host-wide claim
                     makes the app the handler for every URL on its own
                     domain, including the privacy policy — so opening the
                     policy from Settings would bounce straight back into the
                     app, which has no route for it and would show nothing.
                     These prefixes mirror FitSocialLinks.routeFor: if one
                     gains a path, the other has to. -->
                <data android:scheme="https" android:host="fitsocialv2.web.app"
                      android:pathPrefix="/post/"/>
                <data android:scheme="https" android:host="fitsocialv2.web.app"
                      android:pathPrefix="/user/"/>
            </intent-filter>
            <!-- fitsocial://app/post/{id} — the hand-off the hosted page uses
                 when the App Link above was not verified for this install
                 (sideloaded build, or a link opened before verification
                 finished). The `app` host is a placeholder that keeps the path
                 intact for the router; see FitSocialLinks. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="fitsocial" android:host="app"/>
            </intent-filter>
            <!-- Health Connect: show why we request health permissions -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE"/>
            </intent-filter>
        </activity>
        <!-- OAuth redirect receiver: catches the music-service sign-in
             callbacks and hands the auth code back to flutter_web_auth_2.
             Each scheme + host must match the redirect URI configured in the
             matching Dart config *and* the one registered in that service's
             developer dashboard.

             YouTube Music is the exception: Google requires installed apps to
             redirect to the reversed OAuth client ID, so its <data> entry has
             to be filled in once that client exists — see
             YouTubeMusicConfig.callbackScheme. -->
        <activity
            android:name="com.linusu.flutter_web_auth_2.CallbackActivity"
            android:exported="true"
            android:taskAffinity="">
            <intent-filter android:label="flutter_web_auth_2">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="fitsocial" android:host="spotify-callback"/>
                <data android:scheme="fitsocial" android:host="apple-music-callback"/>
            </intent-filter>
        </activity>
        <!-- The plugin declares this activity itself, but without a task
             affinity, so it would default to the package name. MainActivity
             above runs with android:taskAffinity="", and the two must match:
             the browser starts CallbackActivity with FLAG_ACTIVITY_NEW_TASK,
             and Android places it in the task matching *its* affinity. With a
             mismatch the callback lands in a second task, so the auth code
             arrives but the app never returns to the foreground — the user is
             left looking at the browser — and the FLAG_ACTIVITY_CLEAR_TOP the
             plugin uses to dismiss the tab targets the wrong task. -->
        <activity
            android:name="com.linusu.flutter_web_auth_2.AuthenticationManagementActivity"
            android:exported="false"
            android:taskAffinity=""/>

        <!-- Interactive photo cropper (image_cropper -> uCrop on Android).
             Without this activity registration the crop screen crashes with
             ActivityNotFoundException the first time a user picks a photo. -->
        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />

        <!-- Health Connect permission-usage screen (Android 14+) -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE"/>
                <category android:name="android.intent.category.HEALTH_PERMISSIONS"/>
            </intent-filter>
        </activity-alias>
        <!-- FirebaseInitProvider is deliberately NOT declared here.

             It used to be, with android:enabled="false", to dodge a duplicate-
             app crash when the native auto-init and Dart's
             Firebase.initializeApp() both tried to create [DEFAULT]. Leaving it
             off breaks push: when the app has been force-stopped, FCM starts a
             fresh process to show a notification and no Dart ever runs, so
             nothing initialises Firebase and the notification is dropped. The
             one case push exists for is the one that failed.

             It is safe to leave enabled now, and that is checked rather than
             hoped for. firebase_core's Dart side lists the native apps first;
             finding a default one already there, it does not call the native
             initializeApp at all — it compares apiKey, databaseURL and
             storageBucket and returns the existing app when they agree (see
             method_channel_firebase.dart, "Options are roughly the same").
             lib/firebase_options.dart and android/app/google-services.json
             carry byte-identical values for all five fields and neither sets a
             databaseURL, so that comparison passes.

             If those two files are ever regenerated separately and drift, this
             comes back as [core/duplicate-app] at launch. Regenerate both from
             the same project, do not disable this provider again. -->


        <!-- Reads nothing from notifications. Declared because Android grants
             access to MediaSessionManager.getActiveSessions() per *component*,
             and a NotificationListenerService is the only component that can
             hold it — see MediaSessionListener. That access is what lets the
             music island show, and the transport controls drive, whatever the
             user is already playing in Spotify, YouTube Music or anything else,
             with no account linking of any kind.

             android:exported must be true: the system binds this, not us.
             The permission below is held by the system side of that bind, so
             only the system can reach it. -->
        <service
            android:name=".MediaSessionListener"
            android:exported="true"
            android:label="@string/media_session_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService"/>
            </intent-filter>
        </service>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Detect the Health Connect app -->
        <package android:name="com.google.android.apps.healthdata"/>
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE"/>
        </intent>
        <!-- Music apps, so the media-session bridge can put a name to the one
             that is playing. Android 11+ filters package queries, and without
             this getApplicationInfo() throws NameNotFoundException for every
             other app on the phone — the player would fall back to showing
             "com.spotify.music" where it should read "Spotify".

             Declared as an intent rather than a package list on purpose: it
             matches whatever the user actually uses, instead of a hardcoded
             three that would leave every other player unnamed. -->
        <intent>
            <action android:name="android.media.browse.MediaBrowserService"/>
        </intent>
    </queries>
</manifest>
