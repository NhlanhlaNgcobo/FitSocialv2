rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // True when this write only adds or removes the caller's own uid in
    // likedBy, leaving everyone else's likes untouched.
    function isSelfLikeToggle() {
      let before = resource.data.get('likedBy', []);
      let after = request.resource.data.get('likedBy', []);
      let uid = request.auth.uid;
      return (after.toSet() == before.toSet().union([uid].toSet())
              && !(uid in before))
          || (after.toSet() == before.toSet().difference([uid].toSet())
              && (uid in before));
    }

    // Adding a comment bumps commentsCount on the parent post. Allow that
    // for any signed-in user, but only as an exact +1 so the counter can't
    // be set to an arbitrary value.
    function isCommentCountIncrement() {
      return request.resource.data.get('commentsCount', 0)
             == resource.data.get('commentsCount', 0) + 1;
    }

    // Whether the caller's follower edge under {userId} exists once this
    // batch commits. Ties a followersCount change to the actual relationship
    // so the counter can't be inflated by repeat writes.
    function followerEdgeExistsAfter(userId) {
      return existsAfter(
        /databases/$(database)/documents/users/$(userId)/followers/$(request.auth.uid)
      );
    }

    function isFollowIncrement(userId) {
      return request.resource.data.get('followersCount', 0)
             == resource.data.get('followersCount', 0) + 1
          && followerEdgeExistsAfter(userId);
    }

    function isUnfollowDecrement(userId) {
      return request.resource.data.get('followersCount', 0)
             == resource.data.get('followersCount', 0) - 1
          && !followerEdgeExistsAfter(userId);
    }

    // Whether the caller follows {authorId}. The follower edge is the
    // audience: following someone is how you ask to see their day.
    function isFollowerOf(authorId) {
      return exists(
        /databases/$(database)/documents/users/$(authorId)/followers/$(request.auth.uid)
      );
    }

    // The Pulse's author, for rules that live on its subcollections.
    function isPulseAuthor(pulseId) {
      return get(/databases/$(database)/documents/pulses/$(pulseId))
               .data.authorId == request.auth.uid;
    }

    // Whether the caller's view record under {pulseId} exists once this batch
    // commits. Ties a viewCount change to an actual view, so the number can't
    // be inflated by repeat writes.
    function pulseViewExistsAfter(pulseId) {
      return existsAfter(
        /databases/$(database)/documents/pulses/$(pulseId)/views/$(request.auth.uid)
      );
    }

    function isPulseViewIncrement(pulseId) {
      return request.resource.data.get('viewCount', 0)
             == resource.data.get('viewCount', 0) + 1
          && pulseViewExistsAfter(pulseId);
    }

    // --- Usernames -------------------------------------------------------
    //
    // How long an account waits between renames, and how long its old name
    // stays reserved for it afterwards. Both are duplicated from
    // lib/features/auth/domain/username.dart, which cannot be imported here —
    // change one and you must change the other.
    function usernameCooldown() { return duration.value(14, 'd'); }

    // The username the profile will carry once this write commits.
    function requestedHandle() {
      return request.resource.data.get('handle', '');
    }

    // Whether the caller holds the reservation for the handle they are writing
    // onto their profile, as of the end of this batch.
    //
    // getAfter, not get: the reservation and the profile are written in one
    // transaction, so the claim is still pending when this runs. Without the
    // "After" variant a first-time claim would always fail.
    function ownsRequestedHandle(userId) {
      let name = requestedHandle();
      let claim = /databases/$(database)/documents/usernames/$(name);
      return name != ''
             && existsAfter(claim)
             && getAfter(claim).data.uid == userId;
    }

    function handleIsUnchanged() {
      return requestedHandle() == resource.data.get('handle', '');
    }

    // An account with no handle yet is claiming, not renaming. Not throttled:
    // the cooldown exists to make identity changes expensive, and there is no
    // identity to change out of.
    function isFirstHandleClaim() {
      return resource.data.get('handle', '') == '';
    }

    function usernameCooldownElapsed() {
      let last = resource.data.get('handleChangedAt', null);
      return last == null || request.time >= last + usernameCooldown();
    }

    // A rename must stamp handleChangedAt with the request time. Requiring the
    // exact request time is what stops a client backdating the field to clear
    // its own cooldown — FieldValue.serverTimestamp() resolves to precisely
    // this value, so an honest client passes and a crafted one cannot.
    function stampsHandleChange() {
      return request.resource.data.get('handleChangedAt', null) == request.time;
    }

    function isAllowedHandleWrite(userId) {
      return handleIsUnchanged()
             || (ownsRequestedHandle(userId)
                 && (isFirstHandleClaim()
                     || (usernameCooldownElapsed() && stampsHandleChange())));
    }

    // Profile documents.
    //
    // Reads are open to any signed-in user because Explore search and post
    // author details both need to resolve other people's profiles. Only
    // display-safe fields live here — contact details go to /private below.
    //
    // Writes are owner-only, with one narrow exception: another user may move
    // followersCount by exactly ±1, and only when their follower edge ends up
    // in the matching state. No other field can ride along on that write.
    //
    // The owner's own writes carry a second condition: the handle they display
    // must be one they hold in /usernames, and changing it is rate-limited.
    // Without that check the reservation collection would be decorative — a
    // client could simply write any username straight onto its profile.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && ownsRequestedHandle(userId);
      allow update: if request.auth != null
                    && ((request.auth.uid == userId
                         && isAllowedHandleWrite(userId))
                        || (request.resource.data.diff(resource.data)
                              .affectedKeys()
                              .hasOnly(['followersCount'])
                            && (isFollowIncrement(userId)
                                || isUnfollowDecrement(userId))));
      allow delete: if request.auth != null && request.auth.uid == userId;

      // Private account data (email, and anything else that must never be
      // readable by other users). Owner-only, read and write.
      match /private/{docId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }

      // Saved posts are private to their owner. Rules do not cascade into
      // subcollections, so this block is required — without it every bookmark
      // read and write is denied.
      match /bookmarks/{bookmarkId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }

      // Who this user follows. Owned by {userId}.
      match /following/{followedId} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null
                             && request.auth.uid == userId;
      }

      // Who follows this user. Written by the FOLLOWER, not the profile owner,
      // so authorisation keys off the document id instead of {userId}.
      match /followers/{followerId} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null
                             && request.auth.uid == followerId;
      }

      // This user's "last watched" cursor per Pulse author — what decides
      // whether a ring shows as live or spent. Private to its owner: it is a
      // record of what they have been looking at.
      match /pulseSeen/{authorId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }

      // People this user has asked to be notified about. Private to its owner
      // for the same reason as pulseSeen: it is a record of who they are
      // watching, which is nobody else's business.
      match /notifyFor/{targetId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }

      // This user's inbox: who followed them, who liked their posts.
      //
      // Written by the ACTOR, read by the owner — the mirror image of
      // /followers above. Two rules keep that honest: a notification can only
      // be created naming its author as the actor, so nobody can put words in
      // someone else's mouth; and the owner may only ever flip `read`, so
      // marking the list seen can't be used to rewrite what it says.
      //
      // Delete is open to both. The actor withdraws their own notification
      // when they unfollow or unlike, and `resource == null` is allowed
      // because those deletes are unconditional — a follow made before this
      // collection existed has nothing to remove, and that must not fail the
      // unfollow it is batched with.
      match /notifications/{notificationId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
                      && request.auth.uid != userId
                      && request.resource.data.actorId == request.auth.uid;
        allow update: if request.auth != null
                      && ((request.auth.uid == userId
                           && request.resource.data.diff(resource.data)
                                .affectedKeys().hasOnly(['read']))
                          || (request.resource.data.actorId == request.auth.uid
                              && resource.data.actorId == request.auth.uid));
        allow delete: if request.auth != null
                      && (request.auth.uid == userId
                          || resource == null
                          || resource.data.actorId == request.auth.uid);
      }
    }

    // Username reservations. The document id IS the username, normalized —
    // lowercase, no leading '@'. Firestore has no unique-column constraint, so
    // the id is the only thing that can enforce one, and `create` failing on an
    // existing document is the entire uniqueness guarantee.
    //
    // Shape: { uid, claimedAt, releaseAt? }. A live reservation has no
    // releaseAt. Vacating stamps one 14 days out rather than deleting the
    // document, so the name stays held for the account that left it — see the
    // grace-period note in domain/username.dart for why releasing immediately
    // is the dangerous option.
    //
    // The login Cloud Function reads this collection through the Admin SDK,
    // which bypasses these rules entirely.
    match /usernames/{username} {

      // Whether the vacated hold on this name has run out, leaving it free.
      function isReleased() {
        let releaseAt = resource.data.get('releaseAt', null);
        return releaseAt != null && request.time > releaseAt;
      }

      function isVacating() {
        return 'releaseAt' in request.resource.data;
      }

      // Caps how long a name can be held after being vacated. Without a bound
      // a client could stamp releaseAt years out and sit on names it no longer
      // uses. 15 days rather than 14 leaves room for clock skew.
      function releaseAtWithinBounds() {
        return request.resource.data.releaseAt
               <= request.time + duration.value(15, 'd');
      }

      // Ties an active reservation to the profile that displays it, so one
      // account can hold exactly one live name. Without this, nothing stops a
      // client writing reservation documents in a loop and squatting the
      // namespace.
      function matchesOwnProfile() {
        let profile = /databases/$(database)/documents/users/$(request.auth.uid);
        return existsAfter(profile)
               && getAfter(profile).data.get('handle', '') == username;
      }

      // Any signed-in user may check whether a name is free — that is what the
      // hint under the username field is doing. Only a uid and two timestamps
      // live here, and the uid→username mapping is already public through
      // /users; no contact detail is exposed.
      allow read: if request.auth != null;

      // `create` only ever fires when the document is absent, which is exactly
      // "this name is unclaimed". Claiming on someone else's behalf, or
      // creating a name already marked as vacated, are both refused.
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && !isVacating()
                    && matchesOwnProfile();

      // Two legitimate updates: the owner stepping away from a name (stamping
      // releaseAt), and someone taking on a name — their own during its grace
      // period, or anyone's once that period has lapsed.
      allow update: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && (resource.data.uid == request.auth.uid || isReleased())
                    && ((isVacating() && releaseAtWithinBounds())
                        || (!isVacating() && matchesOwnProfile()));

      // Never deleted. Vacating is a stamp, not a removal: a delete would drop
      // the grace period along with the record and put the name straight back
      // in the pool.
      allow delete: if false;
    }

    // Feed posts — authenticated users can read all, write only their own.
    // Any signed-in user may update a post when the only fields touched are
    // the like counters, and only to add/remove THEIR OWN uid — so nobody can
    // like on someone else's behalf or tamper with the rest of the document.
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null
                    && (resource.data.authorId == request.auth.uid
                        || (request.resource.data.diff(resource.data)
                              .affectedKeys()
                              .hasOnly(['likedBy', 'likesCount'])
                            && isSelfLikeToggle())
                        || (request.resource.data.diff(resource.data)
                              .affectedKeys()
                              .hasOnly(['commentsCount'])
                            && isCommentCountIncrement()));
      allow delete: if request.auth != null
                    && resource.data.authorId == request.auth.uid;

      // Comments on a post — readable by any signed-in user; users may
      // create comments as themselves and edit only their own.
      //
      // Deleting allows one extra case: the author of the parent post may
      // remove any comment on it. That covers moderating your own post, and it
      // is required for post deletion to clean up after itself — Firestore
      // leaves subcollections behind when a document is deleted, so the client
      // clears the comments first. The parent post must still exist for this
      // check, which is why deletion happens in that order.
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && request.resource.data.authorId == request.auth.uid;
        allow update: if request.auth != null
                      && resource.data.authorId == request.auth.uid;
        allow delete: if request.auth != null
                      && (resource.data.authorId == request.auth.uid
                          || get(/databases/$(database)/documents/posts/$(postId))
                               .data.authorId == request.auth.uid);
      }
    }

    // Per-post like records at likes/{postId}/users/{uid}, written alongside
    // the post's likesCount inside one transaction. A user may only create or
    // remove their OWN like document.
    match /likes/{postId}/users/{userId} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null
                            && request.auth.uid == userId;
    }

    // Pulses — the 24-hour ephemeral posts.
    //
    // Expiry is NOT enforced here. Rules can't evaluate "now" against a stored
    // field cheaply enough to guard every read, so lapsing is handled by the
    // expiresAt filter every client query carries, plus a Firestore TTL policy
    // on that same field to actually remove the documents. Enable the policy
    // once per project:
    //
    //   gcloud firestore fields ttls update expiresAt \
    //     --collection-group=pulses --enable-ttl --project=fitsocialv2
    //
    // Any signed-in user may update a Pulse they don't own, but only to move
    // viewCount up by one, and only when their own view record exists after
    // the write. No other field can ride along.
    // Readable by the author and by the people who follow them, and nobody
    // else. Enforced per document, which is also why the client query is
    // scoped to authors the reader follows: a list query is checked against
    // every document it returns, so an unscoped one now fails outright rather
    // than quietly handing back strangers' Pulses.
    //
    // The follower lookups are what set the chunk size in
    // FirestorePulseRepository: the rules engine allows 20 document lookups
    // per query, identical ones cached, so a chunk covers ten authors.
    match /pulses/{pulseId} {
      allow read: if request.auth != null
                  && (resource.data.authorId == request.auth.uid
                      || isFollowerOf(resource.data.authorId));
      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null
                    && (resource.data.authorId == request.auth.uid
                        || (request.resource.data.diff(resource.data)
                              .affectedKeys()
                              .hasOnly(['viewCount'])
                            && isPulseViewIncrement(pulseId)));
      allow delete: if request.auth != null
                    && resource.data.authorId == request.auth.uid;

      // Who watched this Pulse.
      //
      // Listing is the author's alone — a viewer list is theirs to see, not
      // the audience's. A single get is also allowed on your own record,
      // which is how the client checks whether it has already counted your
      // view before incrementing the counter.
      match /views/{viewerId} {
        allow get: if request.auth != null
                   && (request.auth.uid == viewerId
                       || isPulseAuthor(pulseId));
        allow list: if request.auth != null && isPulseAuthor(pulseId);
        allow create: if request.auth != null
                      && request.auth.uid == viewerId;
        // The author clears these when deleting a Pulse: Firestore leaves
        // subcollections behind, so the client empties them first while the
        // parent still exists for this check to read.
        allow delete: if request.auth != null
                      && (request.auth.uid == viewerId
                          || isPulseAuthor(pulseId));
      }
    }

    // Run logs — the canonical record of a tracked run, including its GPS
    // route. A route is location history, so unlike /posts these are readable
    // only by the runner who recorded them; the feed gets its own denormalised
    // copy on the post document instead of reading from here.
    match /runs/{runId} {
      allow read: if request.auth != null
                  && resource.data.authorId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.authorId == request.auth.uid;
    }

    // Workout logs — the canonical record of a logged workout, written
    // whether or not it was shared. Private to its author for the same reason
    // as /runs: this is a training history, and the feed already carries its
    // own copy of anything the user chose to share.
    match /workouts/{workoutId} {
      allow read: if request.auth != null
                  && resource.data.authorId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.authorId == request.auth.uid;
    }

    // Meal logs — the canonical record of a logged meal: the totals plus the
    // itemised breakdown the analyzer produced. Private to its author for the
    // same reason as /runs and /workouts, and more so: a food diary is health
    // data. The feed post carries only the headline macros.
    match /meals/{mealId} {
      allow read: if request.auth != null
                  && resource.data.authorId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.authorId == request.auth.uid;
    }

    // The food composition table the meal analyzer resolves against.
    //
    // Readable by any signed-in user so the app can search foods directly.
    // Writes are closed: this is reference data, seeded by
    // `npm run seed:nutrition` with admin credentials, and a client that could
    // edit it could make every user's macros wrong.
    match /nutritionFoods/{foodId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Progress metrics — any authenticated user can read
    match /progress/{metricId} {
      allow read: if request.auth != null;
      allow write: if false; // server-only writes for now
    }
  }
}
