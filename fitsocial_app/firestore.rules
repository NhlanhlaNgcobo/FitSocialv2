rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Post reactions ---------------------------------------------------
    //
    // The single Like button became the reaction control, so a post now
    // carries four fields that move together on one tap: likedBy (who),
    // likesCount (how many people), reactionCounts (how many of each), and
    // reactionsBy (which one each person gave).
    //
    // The record of truth is the caller's own document under
    // likes/{postId}/users/{uid}. Every clause below ties one of those four
    // fields back to it, so a client cannot move a counter it did not earn or
    // touch anybody else's reaction. Reading that document before *and* after
    // the batch is what makes the arithmetic checkable.

    function postReactionPath(postId) {
      return /databases/$(database)/documents/likes/$(postId)/users/$(request.auth.uid);
    }

    // The default reaction, duplicated from FitReaction.defaultReaction in
    // lib/shared/reactions/fit_reaction.dart, which cannot be imported here —
    // change one and you must change the other.
    //
    // It is the answer for a like document with no reaction on it, which is
    // what every like cast before reactions existed looks like. Reading those
    // as "no reaction" instead would refuse the first person to change their
    // mind about an old like.
    function defaultReaction() { return 'love'; }

    function postReactionBefore(postId) {
      return exists(postReactionPath(postId))
             ? get(postReactionPath(postId)).data.get('reaction',
                                                      defaultReaction())
             : '';
    }

    function postReactionAfter(postId) {
      return existsAfter(postReactionPath(postId))
             ? getAfter(postReactionPath(postId)).data.get('reaction',
                                                          defaultReaction())
             : '';
    }

    // likedBy still names everyone who has reacted. The caller may only add or
    // remove themselves, and their presence has to agree with whether they
    // hold a reaction once the batch lands.
    function movesOwnLikedByEntry(current) {
      let uid = request.auth.uid;
      let before = resource.data.get('likedBy', []).toSet();
      let after = request.resource.data.get('likedBy', []).toSet();
      return (current == '' ? !(uid in after) : (uid in after))
          && after.difference([uid].toSet())
             == before.difference([uid].toSet());
    }

    // reactionsBy records which reaction each person gave. Only the caller's
    // own key may move, and it must say what their like document says.
    function movesOwnReactionsByEntry(current) {
      let uid = request.auth.uid;
      let before = resource.data.get('reactionsBy', {});
      let after = request.resource.data.get('reactionsBy', {});
      return after.diff(before).affectedKeys().hasOnly([uid])
          && (current == ''
              ? !(uid in after)
              : after.get(uid, '') == current);
    }

    // The per-reaction totals move by exactly the one give and the one take
    // that the caller's own change implies, and by nothing else — the same
    // test the Pulse counters get, for the same reason.
    function movesReactionCounts(previous, current) {
      let before = resource.data.get('reactionCounts', {});
      let after = request.resource.data.get('reactionCounts', {});
      let changed = after.diff(before).affectedKeys();

      return (previous == ''
              || after.get(previous, 0) == before.get(previous, 0) - 1)
          && (current == ''
              || after.get(current, 0) == before.get(current, 0) + 1)
          && changed.size()
             == (previous == '' ? 0 : 1) + (current == '' ? 0 : 1)
          && (previous == '' || changed.hasAny([previous]))
          && (current == '' || changed.hasAny([current]));
    }

    // likesCount counts people, not taps: it moves when somebody joins or
    // leaves, and stays put when they merely swap one reaction for another.
    function movesLikesCount(previous, current) {
      return request.resource.data.get('likesCount', 0)
             == resource.data.get('likesCount', 0)
                + (current == '' ? 0 : 1)
                - (previous == '' ? 0 : 1);
    }

    function isSelfReactionWrite(postId) {
      let previous = postReactionBefore(postId);
      let current = postReactionAfter(postId);

      // A write claiming these counters moved while the reaction stayed put is
      // a bare counter edit, which is the whole thing being defended against.
      return previous != current
          && movesOwnLikedByEntry(current)
          && movesOwnReactionsByEntry(current)
          && movesReactionCounts(previous, current)
          && movesLikesCount(previous, current);
    }

    // A vote on a poll: the voter's own entry in pollVotes and nothing else,
    // set to one of the poll's answers or removed. Votes are counted from the
    // map itself, so there is no counter here for anyone to inflate.
    function isOwnPollVote() {
      let before = resource.data.get('pollVotes', {});
      let after = request.resource.data.get('pollVotes', {});
      let uid = request.auth.uid;
      return resource.data.get('postType', '') == 'poll'
          && after.diff(before).affectedKeys().hasOnly([uid])
          && (!(uid in after)
              || (after[uid] is int
                  && after[uid] >= 0
                  && after[uid] < resource.data.poll.options.size()));
    }

    // Saying you're in for a meetup, or taking it back: the caller's own entry
    // in rsvps and nothing else, stamped with the server's clock so the
    // who's-in order can't be jumped.
    function isOwnRsvp() {
      let before = resource.data.get('rsvps', {});
      let after = request.resource.data.get('rsvps', {});
      let uid = request.auth.uid;
      return resource.data.get('postType', '') == 'meetup'
          && after.diff(before).affectedKeys().hasOnly([uid])
          && (!(uid in after) || after[uid] == request.time);
    }

    // Adding a comment bumps commentsCount on the parent post. Allow that
    // for any signed-in user, but only as an exact +1 so the counter can't
    // be set to an arbitrary value.
    function isCommentCountIncrement() {
      return request.resource.data.get('commentsCount', 0)
             == resource.data.get('commentsCount', 0) + 1;
    }

    // Whether the caller's follower edge under {userId} exists once this
    // batch commits. Ties a followersCount change to the actual relationship
    // so the counter can't be inflated by repeat writes.
    function followerEdgeExistsAfter(userId) {
      return existsAfter(
        /databases/$(database)/documents/users/$(userId)/followers/$(request.auth.uid)
      );
    }

    function isFollowIncrement(userId) {
      return request.resource.data.get('followersCount', 0)
             == resource.data.get('followersCount', 0) + 1
          && followerEdgeExistsAfter(userId);
    }

    function isUnfollowDecrement(userId) {
      return request.resource.data.get('followersCount', 0)
             == resource.data.get('followersCount', 0) - 1
          && !followerEdgeExistsAfter(userId);
    }

    // Whether the caller follows {authorId}. The follower edge is the
    // audience: following someone is how you ask to see their day.
    function isFollowerOf(authorId) {
      return exists(
        /databases/$(database)/documents/users/$(authorId)/followers/$(request.auth.uid)
      );
    }

    // The Pulse's author, for rules that live on its subcollections.
    function isPulseAuthor(pulseId) {
      return get(/databases/$(database)/documents/pulses/$(pulseId))
               .data.authorId == request.auth.uid;
    }

    // Everyone allowed to see a Pulse: its author, and the people who follow
    // them. The same test the Pulse document itself carries, restated for the
    // subcollections — rules do not cascade, and a reaction or a comment must
    // not be readable by anyone the Pulse is not.
    function isPulseAudience(pulseId) {
      let authorId = get(/databases/$(database)/documents/pulses/$(pulseId))
                       .data.authorId;
      return authorId == request.auth.uid || isFollowerOf(authorId);
    }

    // Whether the caller's view record under {pulseId} exists once this batch
    // commits. Ties a viewCount change to an actual view, so the number can't
    // be inflated by repeat writes.
    function pulseViewExistsAfter(pulseId) {
      return existsAfter(
        /databases/$(database)/documents/pulses/$(pulseId)/views/$(request.auth.uid)
      );
    }

    function isPulseViewIncrement(pulseId) {
      return request.resource.data.get('viewCount', 0)
             == resource.data.get('viewCount', 0) + 1
          && pulseViewExistsAfter(pulseId);
    }

    // --- Pulse reactions -------------------------------------------------
    //
    // A person holds at most one reaction per Pulse, stored as a document
    // under their own uid, and the per-reaction totals are denormalised onto
    // the Pulse itself so the bar can draw a live count during playback.
    //
    // That denormalisation is the thing these rules have to defend: nothing
    // stops a client sending whatever increments it likes, so the counters are
    // only allowed to move in the exact way the caller's OWN reaction document
    // moved. Reading the reaction both before and after the batch is what ties
    // the two together — an arbitrary bump has no matching change of
    // reaction, and is refused.

    function pulseReactionPath(pulseId) {
      return /databases/$(database)/documents/pulses/$(pulseId)/reactions/$(request.auth.uid);
    }

    // The caller's reaction before this write, '' when they had none.
    function pulseReactionBefore(pulseId) {
      return exists(pulseReactionPath(pulseId))
             ? get(pulseReactionPath(pulseId)).data.get('reaction', '')
             : '';
    }

    // The caller's reaction once this write commits, '' when they have taken it
    // back. getAfter, not get: the reaction document and the counters are sent
    // in one batch, so the new reaction is still pending when this runs.
    function pulseReactionAfter(pulseId) {
      return existsAfter(pulseReactionPath(pulseId))
             ? getAfter(pulseReactionPath(pulseId)).data.get('reaction', '')
             : '';
    }

    // Whether the reactionCounts map moved by exactly the one give and the one
    // take that the caller's own change of reaction implies.
    //
    // Four conditions, and all four are needed:
    //   * the reaction actually changed — a write claiming a count moved
    //     while the reaction stayed put is a bare counter edit, which is the
    //     whole thing being defended against;
    //   * the one given went up by one, and the one taken back went down by
    //     one;
    //   * exactly that many keys moved, and they are exactly those keys — so
    //     no third reaction can ride along on the same batch.
    //
    // A first reaction has nothing to take back and a withdrawal has nothing
    // to give, which is what the empty-string arms cover.
    function isPulseReactionCountMove(pulseId) {
      let before = resource.data.get('reactionCounts', {});
      let after = request.resource.data.get('reactionCounts', {});
      let previous = pulseReactionBefore(pulseId);
      let current = pulseReactionAfter(pulseId);
      let changed = after.diff(before).affectedKeys();

      return previous != current
          && (previous == ''
              || after.get(previous, 0) == before.get(previous, 0) - 1)
          && (current == ''
              || after.get(current, 0) == before.get(current, 0) + 1)
          && changed.size()
             == (previous == '' ? 0 : 1) + (current == '' ? 0 : 1)
          && (previous == '' || changed.hasAny([previous]))
          && (current == '' || changed.hasAny([current]));
    }

    // --- Usernames -------------------------------------------------------
    //
    // How long an account waits between renames, and how long its old name
    // stays reserved for it afterwards. Both are duplicated from
    // lib/features/auth/domain/username.dart, which cannot be imported here —
    // change one and you must change the other.
    function usernameCooldown() { return duration.value(14, 'd'); }

    // The username the profile will carry once this write commits.
    function requestedHandle() {
      return request.resource.data.get('handle', '');
    }

    // Whether the caller holds the reservation for the handle they are writing
    // onto their profile, as of the end of this batch.
    //
    // getAfter, not get: the reservation and the profile are written in one
    // transaction, so the claim is still pending when this runs. Without the
    // "After" variant a first-time claim would always fail.
    function ownsRequestedHandle(userId) {
      let name = requestedHandle();
      let claim = /databases/$(database)/documents/usernames/$(name);
      return name != ''
             && existsAfter(claim)
             && getAfter(claim).data.uid == userId;
    }

    function handleIsUnchanged() {
      return requestedHandle() == resource.data.get('handle', '');
    }

    // An account with no handle yet is claiming, not renaming. Not throttled:
    // the cooldown exists to make identity changes expensive, and there is no
    // identity to change out of.
    function isFirstHandleClaim() {
      return resource.data.get('handle', '') == '';
    }

    function usernameCooldownElapsed() {
      let last = resource.data.get('handleChangedAt', null);
      return last == null || request.time >= last + usernameCooldown();
    }

    // A rename must stamp handleChangedAt with the request time. Requiring the
    // exact request time is what stops a client backdating the field to clear
    // its own cooldown — FieldValue.serverTimestamp() resolves to precisely
    // this value, so an honest client passes and a crafted one cannot.
    function stampsHandleChange() {
      return request.resource.data.get('handleChangedAt', null) == request.time;
    }

    function isAllowedHandleWrite(userId) {
      return handleIsUnchanged()
             || (ownsRequestedHandle(userId)
                 && (isFirstHandleClaim()
                     || (usernameCooldownElapsed() && stampsHandleChange())));
    }

    // Profile documents.
    //
    // Reads are open to any signed-in user because Explore search and post
    // author details both need to resolve other people's profiles. Only
    // display-safe fields live here — contact details go to /private below.
    //
    // Writes are owner-only, with one narrow exception: another user may move
    // followersCount by exactly ±1, and only when their follower edge ends up
    // in the matching state. No other field can ride along on that write.
    //
    // The owner's own writes carry a second condition: the handle they display
    // must be one they hold in /usernames, and changing it is rate-limited.
    // Without that check the reservation collection would be decorative — a
    // client could simply write any username straight onto its profile.
    // Who a challenge run belongs to. One document read, used by every rule
    // under an enrollment — the day records and the manual task entries both
    // hang off an id whose owner is only written on the parent.
    //
    // The path is one unbroken literal on purpose: the rules parser will not
    // accept a path split across lines, however long that makes it.
    function enrollmentOwner(enrollmentId) {
      return get(/databases/$(database)/documents/challengeEnrollments/$(enrollmentId)).data.userId;
    }

    // --- User-created running challenges ----------------------------------
    //
    // Who created a challenge, and whether the caller is on it. Both are one
    // document read. The paths are unbroken literals for the same reason the
    // one above is: the rules parser will not accept a path split across lines,
    // however long that makes it.

    function challengeCreator(challengeId) {
      return get(/databases/$(database)/documents/challenges/$(challengeId)).data.get('creatorId', '');
    }

    function isChallengeCreator(challengeId) {
      return request.auth != null && request.auth.uid == challengeCreator(challengeId);
    }

    // Whether the caller holds a participant record on a challenge, in any
    // state. Invited counts: an invitation is what gives somebody the right to
    // look at a private challenge and decide whether to accept it.
    function isOnChallenge(challengeId) {
      return request.auth != null
             && exists(/databases/$(database)/documents/challenges/$(challengeId)/participants/$(request.auth.uid));
    }

    // A participant record at a standing start. The same guard the enrollment
    // create rule applies to Pulse 75, for the same reason: a join that arrived
    // pre-loaded with completed days would be a place somebody awarded
    // themselves. Every one of these is a figure the leaderboard is ordered by,
    // and the engine is the only thing allowed to move them afterwards.
    function participantStartsFromZero(entry) {
      return entry.totalDistanceKm == 0
             && entry.completedDays == 0
             && entry.currentStreak == 0
             && entry.longestStreak == 0
             && entry.completionPercentage == 0
             && entry.rank == 0
             && entry.runCount == 0
             && entry.totalDurationSeconds == 0;
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && ownsRequestedHandle(userId);
      allow update: if request.auth != null
                    && ((request.auth.uid == userId
                         && isAllowedHandleWrite(userId))
                        || (request.resource.data.diff(resource.data)
                              .affectedKeys()
                              .hasOnly(['followersCount'])
                            && (isFollowIncrement(userId)
                                || isUnfollowDecrement(userId))));
      allow delete: if request.auth != null && request.auth.uid == userId;

      // Private account data (email, and anything else that must never be
      // readable by other users). Owner-only, read and write.
      match /private/{docId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }

      // Saved posts are private to their owner. Rules do not cascade into
      // subcollections, so this block is required — without it every bookmark
      // read and write is denied.
      match /bookmarks/{bookmarkId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }

      // Races this user has saved off the running calendar. Private to their
      // owner, like bookmarks: which races somebody is eyeing is their own
      // business, and nothing in the app reads another user's list.
      //
      // The document id is the raceEvents id and the body carries only a
      // timestamp, so there is nothing here worth validating beyond who is
      // writing it.
      match /savedRaces/{eventId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }

      // This user's push registration tokens, one document per device, the
      // token itself as the id. Presence is the whole state -- no enabled flag
      // that could contradict the document existing -- the same shape
      // /notifyFor uses on the other side of the app.
      //
      // Owner-only for READ as well as write, which is the part that matters.
      // A registration token is an address for somebody's phone: anyone who can
      // read one can push to that device, and a token is not the kind of thing
      // a user can rotate once it is out. The Cloud Function that sends on
      // these reads them through the Admin SDK and so is not subject to this.
      //
      // Nothing validates the body, because nothing depends on it -- the id is
      // the only field the sender uses.
      match /fcmTokens/{token} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }

      // Safety contacts: people this user asked to watch over them. See
      // functions/safety.js.
      //
      // The client may only open an invite (status pending) or withdraw one of
      // its own rows. Every transition after that -- accept, decline, revoke --
      // is made by a callable that writes both sides at once, because this
      // relationship is what decides who receives emergency alerts, and a
      // client that could mark its own contact "accepted" could aim those
      // alerts at a stranger.
      match /safetyContacts/{contactId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
                      && request.auth.uid == userId
                      && contactId != userId
                      && request.resource.data.keys().hasOnly(
                           ['contactUid', 'status', 'invitedAt', 'displayName',
                            'handle', 'avatarUrl', 'respondedAt'])
                      && request.resource.data.contactUid == contactId
                      && request.resource.data.status == 'pending'
                      && request.resource.data.invitedAt == request.time
                      && exists(/databases/$(database)/documents/users/$(contactId));
        allow delete: if request.auth != null && request.auth.uid == userId;
        allow update: if false;
      }

      // The mirror: people who asked this user. Written by the function only.
      match /safetyContactOf/{ownerId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      // Safety contacts reached by email: people without FitSocial. Readable
      // by their owner only -- these are other people's email addresses.
      // Written only by the addEmailSafetyContact callable and the
      // confirmation page, so a client can never mark an address confirmed.
      // See functions/safety_email.js.
      //
      // The tracking and confirmation tokens live in /emailLinks, which has
      // no rule at all: closed to every client, read by the Admin SDK only.
      match /emailContacts/{contactId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      // Entry-link taps: which races this user has tapped through to enter.
      //
      // Private to its owner, and the only write the client makes for
      // attribution. A Cloud Function reads these and maintains an anonymous
      // per-race total in raceEntryStats, which is what lets referred volume be
      // reported without publishing a log of who wants to enter what.
      //
      // The document id is the raceEvents id, so a user holds one row per race
      // however many times they tap it. Bounds rather than exact validation:
      // this is the user's own counter and the worst they can do is overstate
      // their own interest, which the Cloud Function's cooldown discounts anyway.
      match /entryTaps/{eventId} {
        function tapIsValid(entry) {
          return entry.keys().hasOnly(['eventId', 'lastTapAt', 'taps', 'ref',
                                       'entryPlatform', 'firstTapAt'])
                 && entry.keys().hasAll(['eventId', 'lastTapAt', 'taps', 'ref'])
                 && entry.eventId == eventId
                 // Server time, not a client clock: the cooldown that keeps the
                 // public total honest is computed from this field, and a
                 // client-set timestamp would let somebody defeat it.
                 && entry.lastTapAt == request.time
                 && entry.taps is int && entry.taps > 0 && entry.taps <= 100000
                 && entry.ref is string && entry.ref.size() == 16
                 && (!('entryPlatform' in entry)
                     || (entry.entryPlatform is string
                         && entry.entryPlatform.size() <= 40));
        }

        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
                      && request.auth.uid == userId
                      && tapIsValid(request.resource.data);
        // Must move forwards. A tap is an increment, and an update that left the
        // counter where it was would be a timestamp edit dressed up as a tap.
        allow update: if request.auth != null
                      && request.auth.uid == userId
                      && tapIsValid(request.resource.data)
                      && request.resource.data.taps > resource.data.taps;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // Who this user follows. Owned by {userId}.
      //
      // READ is owner-only. The counts stay public -- they live on the profile
      // document, which anybody signed in can read -- but the list behind them
      // is the account owner's to look at, and nothing in the app asks for
      // somebody else's. The rules that gate a Pulse on the follow graph use
      // exists() rather than a client read, so they are unaffected.
      match /following/{followedId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, delete: if request.auth != null
                             && request.auth.uid == userId;
      }

      // Who follows this user. Written by the FOLLOWER, not the profile owner,
      // so authorisation keys off the document id instead of {userId} -- while
      // READ, as above, belongs to the person being followed.
      match /followers/{followerId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, delete: if request.auth != null
                             && request.auth.uid == followerId;
      }

      // This user's "last watched" cursor per Pulse author — what decides
      // whether a ring shows as live or spent. Private to its owner: it is a
      // record of what they have been looking at.
      match /pulseSeen/{authorId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }

      // People this user has asked to be notified about. Private to its owner
      // for the same reason as pulseSeen: it is a record of who they are
      // watching, which is nobody else's business.
      match /notifyFor/{targetId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;
      }

      // Your own challenge memberships, kept under you.
      //
      // The hub asks one question -- "which challenges am I on, and who has
      // invited me?" -- and the honest place to answer it is here, in the asker's
      // own subcollection. The engine writes a copy of each participant row to
      // users/{uid}/challengeMemberships/{challengeId} on every write; see
      // mirrorMembership in functions/running_challenges.js.
      //
      // It is written that way because the direct question CANNOT BE ASKED
      // SAFELY. Participant rows live under the challenge, so answering it from
      // there means a collection-group query across every challenge's
      // participants -- and on a collection-group list, rules can see neither
      // `resource` nor the path wildcards. Not the document, not its id: three
      // rule shapes were tried against the emulator and each one failed with a
      // Null value error, which denies. The only rule that lets such a query
      // through is one that tests nothing but `request.auth != null`, and that
      // one hands any signed-in caller the full membership of every private
      // challenge in the database.
      //
      // So there is no rule to write here, and the query itself is gone. Do not
      // reintroduce it: the running_challenges rules tests assert that the sweep
      // stays refused, precisely so this cannot come back by accident.
      //
      // Engine-written, never client-written. A member who could write their own
      // copy could list a challenge they were never on -- and, because the copy
      // carries the distance and rank the hub renders, award themselves a
      // standing on it.
      match /challengeMemberships/{challengeId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      // Badges earned from challenges.
      //
      // Publicly readable — a badge shelf that only its owner can see is not a
      // badge shelf. Closed to every client write, including the owner's: a
      // badge the holder could mint is worth nothing, and these are awarded by
      // the finalisation function alone.
      match /badges/{badgeKey} {
        allow read: if request.auth != null;
        allow write: if false;
      }

      // This user's inbox: who followed them, who liked their posts.
      //
      // Written by the ACTOR, read by the owner — the mirror image of
      // /followers above. Two rules keep that honest: a notification can only
      // be created naming its author as the actor, so nobody can put words in
      // someone else's mouth; and the owner may only ever flip `read`, so
      // marking the list seen can't be used to rewrite what it says.
      //
      // Delete is open to both. The actor withdraws their own notification
      // when they unfollow or unlike, and `resource == null` is allowed
      // because those deletes are unconditional — a follow made before this
      // collection existed has nothing to remove, and that must not fail the
      // unfollow it is batched with.
      match /notifications/{notificationId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
                      && request.auth.uid != userId
                      && request.resource.data.actorId == request.auth.uid;
        allow update: if request.auth != null
                      && ((request.auth.uid == userId
                           && request.resource.data.diff(resource.data)
                                .affectedKeys().hasOnly(['read']))
                          || (request.resource.data.actorId == request.auth.uid
                              && resource.data.actorId == request.auth.uid));
        allow delete: if request.auth != null
                      && (request.auth.uid == userId
                          || resource == null
                          || resource.data.actorId == request.auth.uid);
      }
    }

    // Username reservations. The document id IS the username, normalized —
    // lowercase, no leading '@'. Firestore has no unique-column constraint, so
    // the id is the only thing that can enforce one, and `create` failing on an
    // existing document is the entire uniqueness guarantee.
    //
    // Shape: { uid, claimedAt, releaseAt? }. A live reservation has no
    // releaseAt. Vacating stamps one 14 days out rather than deleting the
    // document, so the name stays held for the account that left it — see the
    // grace-period note in domain/username.dart for why releasing immediately
    // is the dangerous option.
    //
    // The login Cloud Function reads this collection through the Admin SDK,
    // which bypasses these rules entirely.
    match /usernames/{username} {

      // Whether the vacated hold on this name has run out, leaving it free.
      function isReleased() {
        let releaseAt = resource.data.get('releaseAt', null);
        return releaseAt != null && request.time > releaseAt;
      }

      function isVacating() {
        return 'releaseAt' in request.resource.data;
      }

      // Caps how long a name can be held after being vacated. Without a bound
      // a client could stamp releaseAt years out and sit on names it no longer
      // uses. 15 days rather than 14 leaves room for clock skew.
      function releaseAtWithinBounds() {
        return request.resource.data.releaseAt
               <= request.time + duration.value(15, 'd');
      }

      // Ties an active reservation to the profile that displays it, so one
      // account can hold exactly one live name. Without this, nothing stops a
      // client writing reservation documents in a loop and squatting the
      // namespace.
      function matchesOwnProfile() {
        let profile = /databases/$(database)/documents/users/$(request.auth.uid);
        return existsAfter(profile)
               && getAfter(profile).data.get('handle', '') == username;
      }

      // Any signed-in user may check whether a name is free — that is what the
      // hint under the username field is doing. Only a uid and two timestamps
      // live here, and the uid→username mapping is already public through
      // /users; no contact detail is exposed.
      allow read: if request.auth != null;

      // `create` only ever fires when the document is absent, which is exactly
      // "this name is unclaimed". Claiming on someone else's behalf, or
      // creating a name already marked as vacated, are both refused.
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && !isVacating()
                    && matchesOwnProfile();

      // Two legitimate updates: the owner stepping away from a name (stamping
      // releaseAt), and someone taking on a name — their own during its grace
      // period, or anyone's once that period has lapsed.
      allow update: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && (resource.data.uid == request.auth.uid || isReleased())
                    && ((isVacating() && releaseAtWithinBounds())
                        || (!isVacating() && matchesOwnProfile()));

      // Never deleted. Vacating is a stamp, not a removal: a delete would drop
      // the grace period along with the record and put the name straight back
      // in the pool.
      allow delete: if false;
    }

    // Feed posts — authenticated users can read all, write only their own.
    // Any signed-in user may update a post when the only fields touched are
    // the reaction bookkeeping, and only in the way THEIR OWN reaction
    // document moved — so nobody can react on someone else's behalf, inflate a
    // counter, or tamper with the rest of the document.
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null
                    && (resource.data.authorId == request.auth.uid
                        || (request.resource.data.diff(resource.data)
                              .affectedKeys()
                              .hasOnly(['likedBy', 'likesCount',
                                        'reactionCounts', 'reactionsBy'])
                            && isSelfReactionWrite(postId))
                        || (request.resource.data.diff(resource.data)
                              .affectedKeys()
                              .hasOnly(['commentsCount'])
                            && isCommentCountIncrement())
                        || (request.resource.data.diff(resource.data)
                              .affectedKeys()
                              .hasOnly(['pollVotes'])
                            && isOwnPollVote())
                        || (request.resource.data.diff(resource.data)
                              .affectedKeys()
                              .hasOnly(['rsvps'])
                            && isOwnRsvp()));
      allow delete: if request.auth != null
                    && resource.data.authorId == request.auth.uid;

      // Comments on a post — readable by any signed-in user; users may
      // create comments as themselves and edit only their own.
      //
      // Deleting allows one extra case: the author of the parent post may
      // remove any comment on it. That covers moderating your own post, and it
      // is required for post deletion to clean up after itself — Firestore
      // leaves subcollections behind when a document is deleted, so the client
      // clears the comments first. The parent post must still exist for this
      // check, which is why deletion happens in that order.
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && request.resource.data.authorId == request.auth.uid;
        allow update: if request.auth != null
                      && resource.data.authorId == request.auth.uid;
        allow delete: if request.auth != null
                      && (resource.data.authorId == request.auth.uid
                          || get(/databases/$(database)/documents/posts/$(postId))
                               .data.authorId == request.auth.uid);
      }
    }

    // Per-post reaction records at likes/{postId}/users/{uid}, written
    // alongside the post's counters inside one transaction. A user may only
    // create, change or remove their OWN.
    //
    // The document id is the reactor's uid, which is what enforces one
    // reaction per person — there is nowhere to put a second. `update` is what
    // changing your mind needs; the collection kept its name because these are
    // the same documents the Like button always wrote.
    match /likes/{postId}/users/{userId} {
      allow read: if request.auth != null;
      allow create, update, delete: if request.auth != null
                                    && request.auth.uid == userId;
    }

    // Pulses — the 24-hour ephemeral posts.
    //
    // Expiry is NOT enforced here. Rules can't evaluate "now" against a stored
    // field cheaply enough to guard every read, so lapsing is handled by the
    // expiresAt filter every client query carries, plus a Firestore TTL policy
    // on that same field to actually remove the documents. Enable the policy
    // once per project, in the Cloud console under Firestore > Databases >
    // (default) > Time-to-live > Create Policy, with collection group `pulses`
    // and field `expiresAt` — or, where the CLI is installed:
    //
    //   gcloud firestore fields ttls update expiresAt \
    //     --collection-group=pulses --enable-ttl --project=fitsocialv2
    //
    // The reactions and comments subcollections carry their own expiresAt and
    // want their own policies; see _subdocumentExpiry in
    // FirestorePulseRepository for why, and for the collection-group caveat.
    //
    // Any signed-in user may update a Pulse they don't own, but only to move
    // viewCount up by one, and only when their own view record exists after
    // the write. No other field can ride along.
    // Readable by the author and by the people who follow them, and nobody
    // else. Enforced per document, which is also why the client query is
    // scoped to authors the reader follows: a list query is checked against
    // every document it returns, so an unscoped one now fails outright rather
    // than quietly handing back strangers' Pulses.
    //
    // The follower lookups are what set the chunk size in
    // FirestorePulseRepository: the rules engine allows 20 document lookups
    // per query, identical ones cached, so a chunk covers ten authors.
    match /pulses/{pulseId} {
      allow read: if request.auth != null
                  && (resource.data.authorId == request.auth.uid
                      || isFollowerOf(resource.data.authorId));
      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null
                    && (resource.data.authorId == request.auth.uid
                        || (request.resource.data.diff(resource.data)
                              .affectedKeys()
                              .hasOnly(['viewCount'])
                            && isPulseViewIncrement(pulseId))
                        || (request.resource.data.diff(resource.data)
                              .affectedKeys()
                              .hasOnly(['reactionCounts'])
                            && isPulseReactionCountMove(pulseId)));
      allow delete: if request.auth != null
                    && resource.data.authorId == request.auth.uid;

      // Who watched this Pulse.
      //
      // Listing is the author's alone — a viewer list is theirs to see, not
      // the audience's. A single get is also allowed on your own record,
      // which is how the client checks whether it has already counted your
      // view before incrementing the counter.
      match /views/{viewerId} {
        allow get: if request.auth != null
                   && (request.auth.uid == viewerId
                       || isPulseAuthor(pulseId));
        allow list: if request.auth != null && isPulseAuthor(pulseId);
        allow create: if request.auth != null
                      && request.auth.uid == viewerId;
        // The author clears these when deleting a Pulse: Firestore leaves
        // subcollections behind, so the client empties them first while the
        // parent still exists for this check to read.
        allow delete: if request.auth != null
                      && (request.auth.uid == viewerId
                          || isPulseAuthor(pulseId));
      }

      // Which reaction each person picked.
      //
      // Readable by everyone the Pulse is, unlike /views above: a reaction is
      // a public signal, offered on purpose, and the counts and the names
      // behind them are half of what makes anyone join in. Watching is not the
      // same thing, and stays the author's alone.
      //
      // The document id is the reactor's uid, which is what enforces one
      // reaction per person — there is nowhere to put a second.
      //
      // Reactions carry an expiresAt so a TTL policy can sweep them when the
      // Pulse lapses without its author deleting it; the field is written by
      // the reactor and read by nothing in the app.
      match /reactions/{reactorId} {
        allow read: if request.auth != null && isPulseAudience(pulseId);
        allow create, update: if request.auth != null
                              && request.auth.uid == reactorId
                              && request.resource.data.reactorId
                                 == request.auth.uid;
        allow delete: if request.auth != null
                      && (request.auth.uid == reactorId
                          || isPulseAuthor(pulseId));
      }

      // The conversation under a Pulse.
      //
      // Same audience as the Pulse, for the same reason its reactions are: a
      // comment is part of the exchange around it, not a private note. A
      // comment can only be written naming its own author, so nobody can put
      // words in somebody else's mouth.
      //
      // Deleting allows the one extra case a post's comments do: the author of
      // the Pulse may remove anything under it. That covers moderating your
      // own thread, and it is what lets deleting a Pulse clean up after itself
      // — Firestore leaves subcollections behind, so the client empties them
      // while the parent still exists for this check to read.
      match /comments/{commentId} {
        allow read: if request.auth != null && isPulseAudience(pulseId);
        allow create: if request.auth != null
                      && request.resource.data.authorId == request.auth.uid;
        allow update: if request.auth != null
                      && resource.data.authorId == request.auth.uid
                      && request.resource.data.authorId == request.auth.uid;
        allow delete: if request.auth != null
                      && (resource.data.authorId == request.auth.uid
                          || isPulseAuthor(pulseId));
      }
    }

    // Run logs — the canonical record of a tracked run, including its GPS
    // route. A route is location history, so unlike /posts these are readable
    // only by the runner who recorded them; the feed gets its own denormalised
    // copy on the post document instead of reading from here.
    match /runs/{runId} {
      allow read: if request.auth != null
                  && resource.data.authorId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.authorId == request.auth.uid;
    }

    // Live activity shares — an activity in progress, published so that
    // somebody holding the link can watch it on a map.
    //
    // Readable by any signed-in user who can name the document, and by
    // nobody who cannot: the id is a random UUID minted on the sharer's phone
    // and is the whole credential, so `get` is open and `list` is closed. That
    // split is the security model — opening `list` would turn every live
    // location in the app into a query away.
    //
    // Written only by the sharer, and only as themselves. The author may not
    // be reassigned on update, so a document cannot be handed to somebody
    // else's account after the fact.
    match /liveActivities/{shareId} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.status in ['live', 'ended'];
      allow update: if request.auth != null
                    && resource.data.authorId == request.auth.uid
                    && request.resource.data.authorId == resource.data.authorId
                    && request.resource.data.status in ['live', 'ended'];
      allow delete: if request.auth != null
                    && resource.data.authorId == request.auth.uid;
    }

    // Workout logs — the canonical record of a logged workout, written
    // whether or not it was shared. Private to its author for the same reason
    // as /runs: this is a training history, and the feed already carries its
    // own copy of anything the user chose to share.
    match /workouts/{workoutId} {
      allow read: if request.auth != null
                  && resource.data.authorId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.authorId == request.auth.uid;
    }

    // Meal logs — the canonical record of a logged meal: the totals plus the
    // itemised breakdown the analyzer produced. Private to its author for the
    // same reason as /runs and /workouts, and more so: a food diary is health
    // data. The feed post carries only the headline macros.
    match /meals/{mealId} {
      allow read: if request.auth != null
                  && resource.data.authorId == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.authorId == request.auth.uid;
    }

    // The food composition table the meal analyzer resolves against.
    //
    // Readable by any signed-in user so the app can search foods directly.
    // Writes are closed: this is reference data, seeded by
    // `npm run seed:nutrition` with admin credentials, and a client that could
    // edit it could make every user's macros wrong.
    match /nutritionFoods/{foodId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Progress metrics — any authenticated user can read
    match /progress/{metricId} {
      allow read: if request.auth != null;
      allow write: if false; // server-only writes for now
    }

    // --- Challenges -------------------------------------------------------
    //
    // One rule governs this whole section: the client is a display layer. Every
    // value that decides whether a day counted, whether a streak survived,
    // whether somebody was eliminated, what they scored and what they earned is
    // written by a Cloud Function and is closed to clients here — not by
    // convention, and not only in the app code, but at the database.
    //
    // The client writes exactly two things: the running step count, and the two
    // tasks that have no sensor behind them. Both are quarantined into their own
    // documents so that no client write ever lands on a document the engine
    // owns.

    // A user's run at a challenge. Publicly readable, because the leaderboard,
    // the profile chip and a friend's tracker all read it — which is also why
    // nothing private is allowed on this document.
    match /challengeEnrollments/{enrollmentId} {
      allow read: if request.auth != null;

      // Starting a run is the one thing a client may create, and only from a
      // standing start: a create that arrived pre-loaded with completed days or
      // a finished status would be a run somebody awarded themselves.
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId
                    && request.resource.data.status == 'active'
                    && request.resource.data.daysCompleted == 0
                    && request.resource.data.currentStreak == 0
                    && request.resource.data.longestStreak == 0
                    && request.resource.data.consecutiveMissedDays == 0
                    && request.resource.data.pointsEarned == 0;

      // Quitting, and re-stamping the clock. Nothing else.
      //
      // The offset is client-owned by necessity — only the device knows what
      // zone it is in — and it is harmless on its own: it decides which day a
      // write falls on, never whether that day counted. It is capped to a real
      // offset so it cannot be used to manufacture extra days.
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.userId
                    && (
                      (request.resource.data.diff(resource.data)
                          .affectedKeys().hasOnly(['status', 'updatedAt'])
                       && request.resource.data.status == 'abandoned'
                       && resource.data.status in ['active', 'at_risk', 'danger'])
                      ||
                      (request.resource.data.diff(resource.data)
                          .affectedKeys()
                          .hasOnly(['utcOffsetMinutes', 'updatedAt'])
                       && request.resource.data.utcOffsetMinutes is int
                       && request.resource.data.utcOffsetMinutes >= -720
                       && request.resource.data.utcOffsetMinutes <= 840)
                    );

      // A run is history once it has started. Nothing is deleted, so a failed
      // attempt survives and a second attempt can be told apart from it.
      allow delete: if false;

      // The finalised record of one day: which tasks were met, whether it
      // counted, what it paid. Written by the engine, read by its owner.
      match /days/{dayKey} {
        allow read: if request.auth != null
                    && request.auth.uid == enrollmentOwner(enrollmentId);
        allow write: if false;
      }

      // Water and reading — the two tasks with no sensor behind them.
      //
      // Quarantined here rather than allowed as fields on the day document,
      // which is what keeps the engine's record untouchable: a client can move
      // these two numbers and nothing else, and the server decides what they
      // mean. Capped well above their targets so an honest over-count is
      // possible while a nonsense figure is not.
      match /manual/{dayKey} {
        // Each counter is checked only if the write carries it. The client sets
        // one task at a time and merges, so the first tap on water creates a
        // document with no `reading` field at all — demanding both here refused
        // that create, and since the document could then never come into
        // existence, every later tap was refused too. A missing key is a task
        // the user has not touched yet, not an invalid entry.
        function manualEntryIsValid(entry) {
          return entry.keys().hasOnly(['water', 'reading', 'dayKey', 'updatedAt'])
                 && entry.dayKey == dayKey
                 && (!('water' in entry)
                     || (entry.water is int
                         && entry.water >= 0 && entry.water <= 30))
                 && (!('reading' in entry)
                     || (entry.reading is int
                         && entry.reading >= 0 && entry.reading <= 500));
        }

        allow read: if request.auth != null
                    && request.auth.uid == enrollmentOwner(enrollmentId);
        allow create, update: if request.auth != null
                              && request.auth.uid ==
                                   enrollmentOwner(enrollmentId)
                              && manualEntryIsValid(request.resource.data);
        allow delete: if false;
      }
    }

    // How many people are running each challenge. Aggregated on a schedule so
    // the detail screen costs one read instead of a count query.
    match /challengeStats/{challengeKey} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // The durable daily step record.
    //
    // Steps have to be persisted rather than read live, for a plain reason: the
    // job that closes a day runs at 2 AM and cannot ask a sleeping phone how far
    // it walked. The client writes its running total through the day and the
    // highest value for a day key wins.
    //
    // Client-writable, and that is a real concession — steps are the one
    // automatic task whose number passes through the device. It is bounded
    // instead: a figure above 200,000 is not a person walking, and the write is
    // refused rather than flagged.
    match /dailySteps/{docId} {
      // `resource == null` is the whole reason this collection ever held
      // anything. The client writes a day's total inside a transaction, and a
      // transaction has to `get()` the document before it can decide whether
      // the new reading beats the stored one. On the first write of any day
      // that document does not exist yet, and `resource` is null for one of
      // those -- so a rule that reaches into `resource.data` denied the read,
      // the transaction aborted, and the document could never come into
      // existence. Every later write then read a document that still was not
      // there and was refused identically. The collection was empty for every
      // user on every day, and both callers swallow the error, so nothing ever
      // said so.
      //
      // This is the same shape as the bug fixed above in `manual`. Nothing is
      // given away by allowing it: `create` below pins the document id to
      // `<uid>_<dayKey>`, so the most a caller learns is that a key they could
      // already construct for themselves holds nothing.
      allow read: if request.auth != null
                  && (resource == null
                      || request.auth.uid == resource.data.userId);
      allow create, update: if request.auth != null
                            && request.auth.uid == request.resource.data.userId
                            && docId == request.auth.uid + '_' +
                                 request.resource.data.dayKey
                            && request.resource.data.steps is int
                            && request.resource.data.steps >= 0
                            && request.resource.data.steps <= 200000;
      allow delete: if false;
    }

    // The points ledger — every award, as a row.
    //
    // Append-only and server-written. A ledger rather than a running total is
    // what makes a reversal possible when an activity turns out to be invalid,
    // and closing it to clients is what makes the totals mean anything.
    match /pointsLedger/{entryId} {
      allow read: if request.auth != null
                  && request.auth.uid == resource.data.userId;
      allow write: if false;
    }

    // --- Running calendar ---------------------------------------------------
    //
    // The race calendar. Readable by any signed-in user, writable by nobody.
    //
    // This is editorial content, not user content. It is populated by
    // functions/scripts/seed_races.js running under the Admin SDK, which
    // bypasses these rules, and by a moderator promoting a submission. Leaving
    // it closed is what keeps it trustworthy: a runner drives to a start line
    // on the strength of a date in here, and a collection anybody could write
    // would make that date worth nothing.
    match /raceEvents/{eventId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Races submitted through the app, awaiting moderation.
    //
    // Create-only, and deliberately not readable — not even by the person who
    // filed it. A submission is a claim about a public event, and the moderation
    // queue is the one place it is meant to be read; letting clients query it
    // would turn an unreviewed claim into a second, unvetted calendar.
    //
    // The shape is pinned rather than left open because this is the one
    // client-writable door into the calendar's data. Every field is checked for
    // type and length, reviewState must start at 'pending' so a submitter cannot
    // file something pre-approved, and submittedBy has to be the caller.
    match /raceSubmissions/{submissionId} {
      function submissionIsValid(entry) {
        return entry.keys().hasOnly(['submittedBy', 'submittedAt',
                                     'reviewState', 'name', 'startAt', 'city',
                                     'province', 'organiser', 'entryUrl',
                                     'distancesNote', 'notes'])
               && entry.keys().hasAll(['submittedBy', 'submittedAt',
                                       'reviewState', 'name', 'startAt',
                                       'city', 'province'])
               && entry.submittedBy == request.auth.uid
               && entry.submittedAt == request.time
               && entry.reviewState == 'pending'
               && entry.name is string
               && entry.name.size() >= 3 && entry.name.size() <= 140
               && entry.startAt is timestamp
               // A race in the past is not a submission worth queueing, and a
               // date more than three years out is somebody testing the form.
               && entry.startAt > request.time
               && entry.startAt < request.time + duration.value(1100, 'd')
               && entry.city is string
               && entry.city.size() >= 2 && entry.city.size() <= 80
               && entry.province is string && entry.province.size() <= 4
               && (!('organiser' in entry)
                   || (entry.organiser is string
                       && entry.organiser.size() <= 140))
               && (!('entryUrl' in entry)
                   || (entry.entryUrl is string
                       && entry.entryUrl.size() <= 500))
               && (!('distancesNote' in entry)
                   || (entry.distancesNote is string
                       && entry.distancesNote.size() <= 300))
               && (!('notes' in entry)
                   || (entry.notes is string && entry.notes.size() <= 1000));
      }

      allow read: if false;
      allow create: if request.auth != null
                    && submissionIsValid(request.resource.data);
      allow update, delete: if false;
    }

    // Per-race entry-tap totals, derived by onRaceEntryTap from the private
    // per-user records under users/{uid}/entryTaps.
    //
    // Closed to clients in both directions. It is written by a Cloud Function
    // under Admin credentials, and it is read for reporting rather than by the
    // app — there is no screen that needs it, and a per-race popularity figure is
    // not something to hand out before deciding it should be public.
    match /raceEntryStats/{eventId} {
      allow read: if false;
      allow write: if false;
    }

    // Early Worm streaks. Public: the streak is the social object, and a
    // 40-morning run nobody can see is not much of a challenge.
    match /earlyWorm/{userId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // --- User-created running challenges ----------------------------------
    //
    // The second challenge model: somebody sets a distance and a date range,
    // other people join, and a leaderboard says who is doing best. Separate
    // collections from challengeEnrollments on purpose -- see
    // functions/running_challenges.js.
    //
    // ON PRIVACY, AND WHY DISCOVERY LOOKS THE WAY IT DOES.
    //
    // Firestore rules cannot filter a list query. A query that *could* return a
    // document the caller may not read fails outright rather than dropping the
    // row -- so `read` below is not a filter, it is a test every returned
    // document has to pass. That means discovery has to be pinned to
    //
    //     where('visibility', '==', 'public').where('status', '==', 'active')
    //
    // and a broader query over /challenges simply fails, for everybody. That is
    // the behaviour we want: it makes "private challenge data must not leak
    // through public discovery" true by construction rather than by remembering
    // to add a filter at each call site. A private challenge is reachable only
    // by its id, and only by somebody already on it.
    match /challenges/{challengeId} {
      // `.get(field, default)` rather than a bare field read, and that is not
      // style. This collection already held six documents from an abandoned
      // earlier design -- early_worm, forged, grind, pulse, recomp, shift --
      // with a completely different shape and no `visibility` or `creatorId` on
      // them at all. A bare `resource.data.visibility` on one of those is an
      // error rather than a false, and a rule that denies by erroring is a rule
      // whose behaviour nobody chose. Stated explicitly, a document with no
      // visibility is not public, which is the answer we want for the legacy
      // rows and for anything else that arrives malformed.
      //
      // Those six are unreachable either way: nothing in the app or the
      // functions reads this collection by that shape, and before this block
      // existed /challenges had no rule at all, so they were already denied to
      // every client. They are dead data pending a decision to remove them.
      allow read: if request.auth != null
                  && (resource.data.get('visibility', '') == 'public'
                      || request.auth.uid == resource.data.get('creatorId', '')
                      || isOnChallenge(challengeId));

      // Creating one. Everything that decides an outcome is pinned here: a
      // challenge cannot be born completed, cannot claim participants it does
      // not have, and cannot run backwards in time.
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.creatorId
                    && request.resource.data.status == 'active'
                    && request.resource.data.participantCount == 0
                    && request.resource.data.type == 'running'
                    && request.resource.data.title is string
                    && request.resource.data.title.size() >= 3
                    && request.resource.data.title.size() <= 80
                    && request.resource.data.goalValueKm is number
                    && request.resource.data.goalValueKm >= 1
                    && request.resource.data.goalValueKm <= 10000
                    && request.resource.data.dailyMinimumKm is number
                    && request.resource.data.dailyMinimumKm >= 0.1
                    && request.resource.data.dailyMinimumKm <= 200
                    && request.resource.data.visibility in ['public', 'private']
                    && request.resource.data.startDayKey is string
                    && request.resource.data.endDayKey is string
                    && request.resource.data.startDayKey.size() == 10
                    && request.resource.data.endDayKey.size() == 10
                    // Day keys are YYYY-MM-DD, so a string compare is a date
                    // compare, and a backwards range is refused here rather
                    // than producing a challenge with no days in it.
                    && request.resource.data.startDayKey <= request.resource.data.endDayKey
                    && request.resource.data.maxParticipants is int
                    && request.resource.data.maxParticipants > 0
                    && request.resource.data.maxParticipants <= 500
                    && request.resource.data.utcOffsetMinutes is int
                    && request.resource.data.utcOffsetMinutes >= -720
                    && request.resource.data.utcOffsetMinutes <= 840;

      // The creator may retitle it or call it off. Nothing else: the dates, the
      // goal and the visibility are what people agreed to when they joined, and
      // moving them afterwards would rewrite a competition already in progress.
      // participantCount and the completed status belong to the engine.
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.creatorId
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['title', 'description',
                                                  'status', 'updatedAt'])
                    && request.resource.data.status in ['active', 'cancelled']
                    && resource.data.status == 'active';

      // A challenge is history once it exists, exactly like an enrollment. A
      // creator who wants out cancels it, which leaves everybody's record
      // intact rather than deleting a competition other people ran.
      allow delete: if false;

      // One person's standing. The document id IS the participant's uid, which
      // is what makes a duplicate join or a duplicate invite impossible to
      // write rather than something to remember to check for -- the same thing
      // usernames/{username} does for handles.
      match /participants/{userId} {
        // Entitlement is checked BEFORE the denormalised field, and the field
        // defaults to 'private', not 'public'. Both of those are deliberate.
        //
        // A privacy rule has to fail closed. Defaulting a missing `visibility`
        // to 'public' means any participant row written without that field --
        // by an older build, a migration, a hand edit, a bug -- becomes world
        // readable, and the failure is silent because nothing errors. The row
        // is a copy of the parent's visibility kept for read cost; a copy that
        // has gone missing is not evidence that the challenge is public, it is
        // the absence of evidence, and the safe reading of that is 'private'.
        //
        // Putting the two entitlement clauses first also means the common
        // cases -- you reading your own row, a member reading the board --
        // never depend on the denormalised copy being right at all.
        allow read: if request.auth != null
                    && (request.auth.uid == userId
                        || isOnChallenge(challengeId)
                        || resource.data.get('visibility', 'private') == 'public');

        // Joining a public challenge yourself.
        //
        // `visibility` is denormalised onto the row so the read rule above can
        // test a field on the document in front of it. Without it every row of
        // a leaderboard would cost a get() on the parent challenge -- a read
        // per row, on the one screen that lists the most rows.
        allow create: if request.auth != null
                      && request.auth.uid == userId
                      && request.resource.data.userId == userId
                      && request.resource.data.challengeId == challengeId
                      && participantStartsFromZero(request.resource.data)
                      && request.resource.data.status == 'active'
                      && request.resource.data.visibility == 'public'
                      && get(/databases/$(database)/documents/challenges/$(challengeId)).data.visibility == 'public'
                      && get(/databases/$(database)/documents/challenges/$(challengeId)).data.status == 'active';

        // Or being invited to one, which only its creator may do. An invitation
        // is a participant record that has not accepted yet, so it starts from
        // zero like any other.
        allow create: if isChallengeCreator(challengeId)
                      && request.auth.uid != userId
                      && request.resource.data.userId == userId
                      && request.resource.data.challengeId == challengeId
                      && participantStartsFromZero(request.resource.data)
                      && request.resource.data.status == 'invited';

        // The creator's own row on the challenge they are creating.
        //
        // createChallenge writes the challenge and then enrols its creator, and
        // neither rule above covers that on a PRIVATE challenge: the self-join
        // rule is written for public ones, and the invite rule is written for
        // somebody other than the caller. Three private challenges shipped with
        // no participant rows at all -- not even their creator's -- because of
        // exactly that gap, which also left them stuck at participantCount 0.
        allow create: if isChallengeCreator(challengeId)
                      && request.auth.uid == userId
                      && request.resource.data.userId == userId
                      && request.resource.data.challengeId == challengeId
                      && participantStartsFromZero(request.resource.data)
                      && request.resource.data.status == 'active';

        // Inviting somebody who is still deciding, again.
        //
        // The invite sheet writes the whole document with set(), so the second
        // tap on Invite is an update rather than a create and was refused --
        // the creator is not the row's owner, and the transition rule below is
        // written for the person answering. A resend is only allowed while they
        // are still deciding and only back into the same state, so it can
        // neither reset somebody's distance nor drag a person who declined back
        // into an invitation they already answered.
        allow update: if isChallengeCreator(challengeId)
                      && request.auth.uid != userId
                      && resource.data.status == 'invited'
                      && request.resource.data.status == 'invited'
                      && request.resource.data.userId == userId
                      && request.resource.data.challengeId == challengeId
                      && participantStartsFromZero(request.resource.data);

        // Accepting, declining, leaving. The caller moves their own status and
        // touches nothing else -- every figure the board is ordered by is
        // outside the allowed key set and is refused here.
        allow update: if request.auth != null
                      && request.auth.uid == userId
                      && request.resource.data.diff(resource.data)
                           .affectedKeys().hasOnly(['status', 'joinedAt',
                                                    'updatedAt'])
                      && (
                        (resource.data.status == 'invited'
                         && request.resource.data.status in ['active', 'declined'])
                        ||
                        (resource.data.status in ['active', 'completed']
                         && request.resource.data.status == 'left')
                      );

        allow delete: if false;

        // The per-day record the streak is derived from. Engine-written, and
        // readable by anyone already on the challenge -- which is what lets a
        // board show somebody else's recent qualifying activity.
        match /days/{dayKey} {
          allow read: if request.auth != null && isOnChallenge(challengeId);
          allow write: if false;
        }
      }

      // The activity-to-challenge attribution records. The document id is the
      // activity id, and that IS the UNIQUE(challenge_id, activity_id)
      // constraint the design calls for.
      //
      // Closed to clients entirely. These are what every total is rebuilt from,
      // so a client that could write one could manufacture distance it never
      // ran -- which is the whole thing a server-side engine exists to prevent.
      match /attributions/{activityId} {
        allow read: if request.auth != null && isOnChallenge(challengeId);
        allow write: if false;
      }
    }

    // --- Safety: location shares and panic events -------------------------
    //
    // See functions/safety.js and spec part A.

    // Whether [uid] is one of [ownerId]'s ACCEPTED safety contacts. A get on a
    // missing document errors, and an error denies -- which is the answer
    // wanted for a stranger.
    function isAcceptedSafetyContact(ownerId, uid) {
      return get(/databases/$(database)/documents/users/$(ownerId)/safetyContacts/$(uid)).data.status == 'accepted';
    }

    // Every viewer of a share must be an accepted contact. Rules cannot loop,
    // so the three slots are spelled out; three is the contact cap
    // (maxAcceptedSafetyContacts), and the size check refuses anything longer.
    function viewersAreAccepted(ownerId, viewers) {
      return viewers is list
             && viewers.size() >= 1 && viewers.size() <= 3
             && isAcceptedSafetyContact(ownerId, viewers[0])
             && (viewers.size() < 2 || isAcceptedSafetyContact(ownerId, viewers[1]))
             && (viewers.size() < 3 || isAcceptedSafetyContact(ownerId, viewers[2]));
    }

    // A bounded, foreground-only position share. Four hours at most, set at
    // creation and never extendable; a scheduled function closes stale ones.
    match /locationShares/{shareId} {
      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.status == 'active'
                    && request.resource.data.startedAt == request.time
                    && request.resource.data.expiresAt is timestamp
                    && request.resource.data.expiresAt > request.time
                    // Four hours, plus five minutes' slack: expiresAt is
                    // computed on the phone, and a clock a minute fast must
                    // not refuse the share outright.
                    && request.resource.data.expiresAt <= request.time + duration.value(245, 'm')
                    && request.resource.data.get('endedAt', null) == null
                    && viewersAreAccepted(request.auth.uid, request.resource.data.viewerIds);
      allow read: if request.auth != null
                  && (resource.data.ownerId == request.auth.uid
                      || request.auth.uid in resource.data.viewerIds);
      // Position ticks and stopping. Who can see it, and until when, are fixed
      // at creation.
      allow update: if request.auth != null
                    && resource.data.ownerId == request.auth.uid
                    && resource.data.status == 'active'
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['current', 'status', 'endedAt'])
                    && request.resource.data.status in ['active', 'ended'];
      allow delete: if false;
    }

    // One document per panic. The client writes who raised it and where they
    // are -- never who to tell. notifiedUserIds must arrive empty; the
    // function fills it from accepted contacts, and this rule is the first of
    // two locks on that door.
    match /panicEvents/{eventId} {
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(
                         ['userId', 'status', 'duress', 'location',
                          'batteryPercent', 'notifiedUserIds', 'raisedAt',
                          'closedAt', 'clientRaisedAtMillis'])
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'active'
                    && request.resource.data.duress == false
                    && request.resource.data.raisedAt == request.time
                    && request.resource.data.get('closedAt', null) == null
                    && request.resource.data.get('notifiedUserIds', []).size() == 0;
      allow read: if request.auth != null
                  && (resource.data.userId == request.auth.uid
                      || request.auth.uid in resource.data.get('notifiedUserIds', []));
      // Only the raiser, and only while the event is open. Three writes:
      //
      //   - the live position, every 30 seconds, for as long as it is open --
      //     through a duress cancel too, which is when it matters most;
      //   - active -> duress: the duress PIN, which leaves the event open;
      //   - active or duress -> resolved: the safe PIN. From duress this is the
      //     user ending it later, once really safe. The PIN is checked on the
      //     phone; these rules cannot see it.
      //
      // Nothing reopens a resolved event, and nothing here touches who was
      // notified.
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && resource.data.status in ['active', 'duress']
                    && ((request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['current'])
                         && request.resource.data.current.keys().hasOnly(
                              ['lat', 'lng', 'accuracy', 'batteryPercent', 'updatedAt'])
                         && request.resource.data.current.updatedAt == request.time)
                        || (resource.data.status == 'active'
                            && request.resource.data.diff(resource.data).affectedKeys()
                                 .hasOnly(['status', 'duress'])
                            && request.resource.data.status == 'duress'
                            && request.resource.data.duress == true)
                        || (request.resource.data.diff(resource.data).affectedKeys()
                              .hasOnly(['status', 'closedAt'])
                            && request.resource.data.status == 'resolved'
                            && request.resource.data.closedAt == request.time));
      allow delete: if false;

      // "I'm responding". Only someone the alert was actually sent to, and
      // only as themselves. Readable by the raiser and the other contacts.
      match /acknowledgements/{uid} {
        allow create: if request.auth != null
                      && request.auth.uid == uid
                      && request.auth.uid in get(/databases/$(database)/documents/panicEvents/$(eventId)).data.get('notifiedUserIds', [])
                      && request.resource.data.keys().hasOnly(['displayName', 'acknowledgedAt'])
                      && request.resource.data.acknowledgedAt == request.time;
        allow read: if request.auth != null
                    && (get(/databases/$(database)/documents/panicEvents/$(eventId)).data.userId == request.auth.uid
                        || request.auth.uid in get(/databases/$(database)/documents/panicEvents/$(eventId)).data.get('notifiedUserIds', []));
        allow update, delete: if false;
      }
    }

  }
}
