VISION_MODEL="anthropic/claude-sonnet-5"

# Lets signInWithUsername verify a password against Identity Toolkit, so a
# username login never has to send the account's email address to the client.
# Not a secret: this is the same web apiKey in lib/firebase_options.dart, which
# ships inside every copy of the app. Kept here rather than in Secret Manager
# for that reason.
#
# Not named FIREBASE_WEB_API_KEY: the Functions runtime reserves the FIREBASE_
# prefix and refuses to load a .env that uses it.
WEB_API_KEY="AIzaSyDHZHrMc-S7Sv1FezsMawNg-7YxK_EXQbA"

# Optional USDA FoodData Central fallback for foods missing from
# data/nutrition_foods.json. Free key: https://fdc.nal.usda.gov/api-key-signup
# Leave unset to skip the lookup entirely.
# FDC_API_KEY=""
